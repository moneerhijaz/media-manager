# Copy this template to .env and keep real credentials there, never here.
# .env is Git-ignored. Restrict access with: chmod 600 .env
# The CLI automatically loads supported credentials; Docker Compose also reads .env.

# TMDB: use the API Read Access Token, not the shorter API key.
TMDB_READ_TOKEN=''

# OpenSubtitles.com: username, application API key, and account password.
# Supplying these enables automatic login; an access token is not required.
OPENSUBTITLES_USERNAME=''
OPENSUBTITLES_API_KEY=''
OPENSUBTITLES_PASSWORD=''
# Optional existing bearer token. Leave empty for password-based login.
OPENSUBTITLES_TOKEN=''

# Docker Compose only: library mount and networking.
# CLI users still run media-manager from their library directory.
# Container library roots (JSON array); no primary library is required.
# Add matching mounts in
# compose.override.yaml; see compose.multi-library.example.yaml.
MEDIA_LIBRARIES='[]'
MEDIA_MANAGER_UID=1000
MEDIA_MANAGER_GID=1000
MEDIA_MANAGER_BIND=0.0.0.0
MEDIA_MANAGER_PORT=8787
